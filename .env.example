# JATIN — environment template. Real values live in .env (gitignored) locally
# and in Railway secrets in production. Nothing in this file is a secret.

PORT=8080

# Two-tier database access (law 2.2 — structural, not a promise):
#   DATABASE_URL      — the OWNER role. Migrations, seed, tooling.
#   APP_DATABASE_URL  — the restricted runtime role (jatin_app). The API hot
#                       path connects here, so the append-only grants in
#                       migration 0002 bind the production behaviour.
# Production: point APP_DATABASE_URL at the restricted role on Railway Postgres.
DATABASE_URL=postgresql://jatin:***@127.0.0.1:5432/jatin
APP_DATABASE_URL=postgresql://jatin_app:***@127.0.0.1:5432/jatin

# 32 random bytes, base64. Wrap key for the credential + env vaults.
#   openssl rand -base64 32
MASTER_KEY=

# HS256 signing secret for sessions.
#   openssl rand -hex 32
JWT_SECRET=

# O3 — the operator account is seeded from backend env (startup bootstrap).
ADMIN_USERNAME=jatin
ADMIN_PASSWORD=

# Cookie/CORS origin of the website.
WEB_ORIGIN=http://localhost:8080

# Phase 3+: quota windows, heartbeats, atomic counters
REDIS_URL=
